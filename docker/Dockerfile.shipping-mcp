# ==========================================
# Stage 1: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY services/shipping-mcp/package.json ./services/shipping-mcp/
COPY services/shipping-mcp/tsconfig.json ./services/shipping-mcp/

RUN npm install

COPY packages/shared/src ./packages/shared/src
COPY services/shipping-mcp/src ./services/shipping-mcp/src

RUN npm run build -w packages/shared && npm run build -w services/shipping-mcp

# ==========================================
# Stage 2: Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4003

COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY services/shipping-mcp/package.json ./services/shipping-mcp/
RUN npm install --omit=dev

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/services/shipping-mcp/dist ./services/shipping-mcp/dist

USER node

EXPOSE 4003

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4003/healthz || exit 1

CMD ["node", "services/shipping-mcp/dist/index.js"]
