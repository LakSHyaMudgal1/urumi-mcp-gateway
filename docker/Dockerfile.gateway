# ==========================================
# Stage 1: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root configuration
COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY services/gateway/package.json ./services/gateway/
COPY services/gateway/tsconfig.json ./services/gateway/

# Install build dependencies
RUN npm install

# Copy source code
COPY packages/shared/src ./packages/shared/src
COPY services/gateway/src ./services/gateway/src

# Compile TypeScript
RUN npm run build -w packages/shared && npm run build -w services/gateway

# ==========================================
# Stage 2: Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4000

# Install production dependencies only
COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY services/gateway/package.json ./services/gateway/
RUN npm install --omit=dev

# Copy compiled JavaScript from builder
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/services/gateway/dist ./services/gateway/dist

# Security: Run as unprivileged non-root user
USER node

EXPOSE 4000

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4000/healthz || exit 1

CMD ["node", "services/gateway/dist/index.js"]
