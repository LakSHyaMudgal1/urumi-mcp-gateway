# ==========================================
# Stage 1: Builder
# ==========================================
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json tsconfig.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/tsconfig.json ./packages/shared/
COPY services/inventory-mcp/package.json ./services/inventory-mcp/
COPY services/inventory-mcp/tsconfig.json ./services/inventory-mcp/

RUN npm install

COPY packages/shared/src ./packages/shared/src
COPY services/inventory-mcp/src ./services/inventory-mcp/src

RUN npm run build -w packages/shared && npm run build -w services/inventory-mcp

# ==========================================
# Stage 2: Production Runtime
# ==========================================
FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=4002

COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY services/inventory-mcp/package.json ./services/inventory-mcp/
RUN npm install --omit=dev

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/services/inventory-mcp/dist ./services/inventory-mcp/dist

USER node

EXPOSE 4002

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:4002/healthz || exit 1

CMD ["node", "services/inventory-mcp/dist/index.js"]
