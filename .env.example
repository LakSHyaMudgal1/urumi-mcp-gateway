# ==========================================
# Urumi MCP Gateway Platform Environment
# (Names and placeholders only - DO NOT commit real secrets)
# ==========================================

# Gateway Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL=sqlite://./urumi_gateway.db
JWT_SECRET=your-secure-jwt-secret-placeholder-minimum-32-chars

# Initial Admin Bootstrap (Used only for first-time seeding)
INITIAL_ADMIN_EMAIL=admin@urumi.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_NAME=Platform Administrator

# Upstream Service URLs (In-cluster or local development)
WOOCOMMERCE_MCP_URL=http://woocommerce-mcp:4001/mcp
INVENTORY_MCP_URL=http://inventory-mcp:4002/mcp
SHIPPING_MCP_URL=http://shipping-mcp:4003/mcp

# WooCommerce Upstream Service Settings
WOOCOMMERCE_PORT=4001
WOOCOMMERCE_STORE_URL=http://woocommerce.default.svc.cluster.local
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_consumer_secret
WOOCOMMERCE_MOCK_FALLBACK=true

# Inventory Upstream Service Settings
INVENTORY_PORT=4002

# Shipping Upstream Service Settings
SHIPPING_PORT=4003

# LLM Chat Agent Configuration
# Supported providers: mock (deterministic zero-cost testing/demo), openai, ollama, gemini
# Keep provider API keys in server environment / Kubernetes Secrets; NEVER expose to client bundle
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_MAX_STEPS=5
